# Godot 4 specific ignores
.godot/
.tools/
builds/
artifacts/
*.translation

# Stray generated icon copy (project icon is icon.svg, see project.godot)
/icon.png
/icon.png.import

# Godot-specific exports
*.pck
*.apk
*.aab
*.exe
*.wasm
*.html
*.js
# ...but the web export shell is source code, not an export artifact
!scripts/art/*.html

# OS specific ignores
.DS_Store
Thumbs.db
desktop.ini

# Editors & IDEs
.idea/
.vscode/*
!.vscode/mcp.json
*.swp
*.bak

# Local secrets (Aholo API key) - never commit
.env
.env.*
!.env.example

# Aholo raw zip archives (preserve locally, do not commit huge archives to git)
assets/models/aholo/**/*_lux3d.zip
assets/models/aholo/ENV_09_*/source/rejected_*/

# Local pipeline exchange
assets/models/aholo/_ipc/

# AI session state
.zcode/
.session-export/

# --- Aholo Hackathon 参赛材料（本地留档，不推送 GitHub） ---
# 报告正文与 20 张交付图提交在本地分支 local/hackathon-report（3 个 commit）；
# master 只保留本段忽略规则，保证日后 push master 不会把它们带上去。
/PROJECT_REPORT.md
/docs/AHOLO_HACKATHON_PROJECT_REPORT.md
assets/art_references/delivery/*_rendered.png
assets/art_references/delivery/*_new.png
