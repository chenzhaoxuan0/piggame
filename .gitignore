# Godot 4 specific ignores
.godot/
.tools/
builds/
artifacts/
*.translation

# Stray generated icon copy (project icon is icon.svg, see project.godot)
/icon.png
/icon.png.import

# Godot-specific exports
*.pck
*.apk
*.aab
*.exe
*.wasm
*.html
*.js

# OS specific ignores
.DS_Store
Thumbs.db
desktop.ini

# Editors & IDEs
.idea/
.vscode/*
!.vscode/mcp.json
*.swp
*.bak

# Local secrets (Aholo API key) - never commit
.env
.env.*
!.env.example

# Aholo raw zip archives (preserve locally, do not commit huge archives to git)
assets/models/aholo/**/*_lux3d.zip
assets/models/aholo/ENV_09_*/source/rejected_*/

# Local pipeline exchange
assets/models/aholo/_ipc/

# AI session state
.zcode/
.session-export/
