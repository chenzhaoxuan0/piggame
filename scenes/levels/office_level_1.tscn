text = "🌾 《特立独行的猪》第一幕 · 田园寓言归途"
horizontal_alignment = 1

[node name="Quote" type="Label" parent="HUD/EndScreenPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_font_sizes/font_size = 16
text = "“世间只有一种真正的特立独行，那就是认清生活的规训后，依然选择从容而体面地活出自己。”
“不随波逐流，亦不愤世嫉俗；守住内心的火，走属于自己的路。”

愿每一颗不肯被驯服的灵魂，都能在阳光下的广阔田野里自由漫步。"
horizontal_alignment = 1

