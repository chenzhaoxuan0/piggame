extends "res://tests/scene/test_full_journey.gd"
## No teleport: visit the three companions via the mountain paths.
func _run() -> void:
	game=root.get_node("GameManager")
	office=load("res://scenes/levels/office_level_1.tscn").instantiate()
	root.add_child(office)
	await create_timer(.6).timeout
	await _dialogue()
	await _follow(L.path("summit"))
	await _follow([Vector3(46,24,55),Vector3(46,24,42),Vector3(42.4,24,37)])
	await _interact()
	await _dialogue()
	_check(game.npc_completed.ox,"ox story complete on terrace")
	_check(office.farm.get_node("NPC_ox").position.distance_to(L.RESTS.ox)<.1,"ox reaches water")
	await _follow([Vector3(56,24,38),Vector3(72,24,20)])
	await _follow(L.path("creek"))
	await _follow([Vector3(-40,16,-32),Vector3(-40,16,-41.5),Vector3(-50.6,16,-41.5)])
	await _interact()
	await _dialogue()
	_check(game.npc_completed.sheep and not office.farm._sheep_tag.visible,"sheep story removes tag")
	await _follow([Vector3(-49,16,-44.5),Vector3(-38,16,-53),Vector3(-66,16,-62)])
	await _follow(L.path("woodland"))
	await _follow([Vector3(20,8,-102),Vector3(22.6,8,-106)])
	await _interact()
	await _dialogue()
	_check(game.has_read_record,"record board independently reachable")
	await _follow([Vector3(22,8,-111),Vector3(24.6,8,-120)])
	await _interact()
	await _dialogue()
	_check(game.npc_completed.horse and office.player.dash_enabled,"horse story grants dash")
	# Walk the actual 50 m north straight; don't infer scale only from a constant.
	await _follow([Vector3(15,8,-109),Vector3(65,8,-109)])
	_check(office.farm.recoveries==0,"all companion routes without falling")
	_check(not office.overlay.visible,"all story grounds accessible")
	print("PASTORAL_ENVIRONMENT_TEST failures=%d" % failures)
	quit(0 if failures==0 else 1)
