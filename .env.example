# 复制本文件为 .env 并填入真实值后使用（.env 本身不会进版本库）
# Aholo API Key 申请地址: https://labs.aholo3d.cn/api-keys
AHOLO_API_KEY=your_api_key_here

# Aholo 区域，国内站固定 cn
AHOLO_REGION=cn

# 本机代理地址（npx 拉包 + API 调用都走它）；不需要代理时留空即可
AHOLO_PROXY_URL=http://127.0.0.1:7897

# 以下仅在使用 Python 版 Lux3D 客户端（skillhub 官方 skill）时才需要，
# 与 AHOLO_API_KEY 是同一个 Key
LUX3D_API_KEY=your_api_key_here
LUX3D_BASE_URL=https://api.aholo3d.cn
