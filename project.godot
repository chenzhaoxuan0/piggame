config_version=5

[application]

config/name="特立独行的猪：逃离牛马大厦"
config/name_localized={
"en": "A Maverick Pig: Escape the Animal Office",
"zh_CN": "特立独行的猪：逃离牛马大厦"
}
config/description="2.5D 职场反讽逃脱游戏，群核科技AHOLO+GPT6Astra支持，扮演一只特立独行的猪逃出大厂写字楼！"
config/version="0.1.0-mvp"
run/main_scene="res://scenes/ui/character_selection.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
DialogueManager="*res://scripts/core/dialogue_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

